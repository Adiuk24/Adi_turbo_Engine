  --model <path>        GGUF model path (required)
  --repeats <n>         Repeats (default: 3)
  --pp <n>              Prompt tokens (default: 512)
  --tg <n>              Generation tokens (default: 128)
  --threads <n>         CPU threads (default: auto)
  --batch <n>           Batch size (default: 512)
  --ubatch <n>          UBatch size (default: 512)
  --ngl <n>             GPU layers (default: 99)
  --cpu                 Force CPU mode
  --turbo-kv            Enable AdiTurbo KV runtime path
  --qjl                 Enable turbo-kv qjl path
  --proj-dim <n>        turbo-kv projection dim (default: 64)
  --ctk <type>          KV K cache type (default with --turbo-kv: q8_0)
  --ctv <type>          KV V cache type (default with --turbo-kv: f16)

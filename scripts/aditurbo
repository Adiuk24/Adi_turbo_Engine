#!/usr/bin/env bash
set -euo pipefail

# AdiTurbo CLI
# Product: AdiTurbo
# Stack: Weights + KV + Runtime
ADITURBO_VERSION="0.2.0"

SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -h "${SOURCE_PATH}" ]]; do
    SOURCE_DIR="$(cd -P "$(dirname "${SOURCE_PATH}")" && pwd)"
    SOURCE_LINK="$(readlink "${SOURCE_PATH}")"
    if [[ "${SOURCE_LINK}" != /* ]]; then
        SOURCE_PATH="${SOURCE_DIR}/${SOURCE_LINK}"
    else
        SOURCE_PATH="${SOURCE_LINK}"
    fi
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE_PATH}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
BUILD_DIR="${ADITURBO_BUILD_DIR:-${ROOT_DIR}/build}"
BIN_DIR="${BUILD_DIR}/bin"
PYTHON_BIN="${ADITURBO_PYTHON:-python3}"

log() {
    printf '[aditurbo] %s\n' "$*"
}

warn() {
    printf '[aditurbo][warn] %s\n' "$*" >&2
}

die() {
    printf '[aditurbo][error] %s\n' "$*" >&2
    exit 1
}

detect_parallelism() {
    if command -v sysctl >/dev/null 2>&1; then
        sysctl -n hw.ncpu 2>/dev/null || echo 8
        return
    fi
    if command -v nproc >/dev/null 2>&1; then
        nproc
        return
    fi
    echo 8
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_file() {
    [[ -f "$1" ]] || die "file not found: $1"
}

require_dir() {
    [[ -d "$1" ]] || die "directory not found: $1"
}

require_bin() {
    [[ -x "$1" ]] || die "binary not found (run 'aditurbo install'): $1"
}

default_dataset_path() {
    if [[ -f "${ROOT_DIR}/../wikitext-2-raw/wiki.test.raw" ]]; then
        printf '%s\n' "${ROOT_DIR}/../wikitext-2-raw/wiki.test.raw"
        return
    fi
    if [[ -f "${ROOT_DIR}/wikitext-2-raw/wiki.test.raw" ]]; then
        printf '%s\n' "${ROOT_DIR}/wikitext-2-raw/wiki.test.raw"
        return
    fi
    printf '%s\n' "${ROOT_DIR}/../wikitext-2-raw/wiki.test.raw"
}

print_main_help() {
    cat <<EOF
AdiTurbo CLI (Adi CCP)
Usage:
  aditurbo <command> [options]
  adi-ccp  <command> [options]

Commands:
  install   Build required binaries and optionally link CLI to PATH
  info      Inspect GGUF model metadata and quantization compatibility
  convert   Convert HF->F16->quantized GGUF (or F16->quantized directly)
  run       Run model inference with sane defaults
  ui        Launch AdiTurbo local chat UI (Ollama-style)
  bench     Run standardized throughput benchmark
  test      Run coherence + perplexity gate checks
  package   Build distributable tarball for deployment
  help      Show this help

Examples:
  aditurbo install --link-dir "\$HOME/.local/bin"
  aditurbo info --model /path/model.gguf
  aditurbo convert --f16 /path/model-F16.gguf --type TQ3_0 --out /path/model-TQ3_0.gguf
  aditurbo run --model /path/model.gguf --prompt "The capital of France is"
  aditurbo ui --model /path/model.gguf
  aditurbo bench --model /path/model.gguf
  aditurbo test --model /path/model.gguf --baseline /path/baseline.gguf
  aditurbo package --output-dir /tmp
EOF
}

print_install_help() {
    cat <<EOF
Usage: aditurbo install [options]

Options:
  --build-dir <path>    Build directory (default: ${BUILD_DIR})
  --build-type <type>   CMake build type (default: Release)
  --parallel <n>        Build parallelism (default: auto)
  --link-dir <path>     Link aditurbo into this dir (default: ~/.local/bin)
  --no-link             Skip symlink creation
  --no-build            Skip compile step (link only)
  -h, --help            Show help
EOF
}

print_info_help() {
    cat <<EOF
Usage: aditurbo info --model <path/to/model.gguf>
EOF
}

print_convert_help() {
    cat <<EOF
Usage: aditurbo convert [options]

Input source (choose one):
  --f16 <path>          Source F16/BF16 GGUF
  --hf-dir <path>       Local HuggingFace model directory
  --hf-repo <id>        HuggingFace repo id to download first

Options:
  --hf-local-dir <path> Download directory for --hf-repo
  --f16-out <path>      Output path for generated F16 GGUF
  --out <path>          Output path for quantized GGUF
  --type <qtype>        Quant type (default: TQ3_0)
  --imatrix <path>      Existing imatrix file
  --calibration <file>  Text dataset to generate imatrix automatically
  --chunks <n>          Imatrix chunks (default: 20)
  --ctx <n>             Imatrix ctx size (default: 512)
  --threads <n>         Threads for imatrix (default: auto)
  --ngl <n>             GPU layers for imatrix (default: 99)
  --force               Skip source-type guard
  -h, --help            Show help
EOF
}

print_run_help() {
    cat <<EOF
Usage: aditurbo run --model <path> [options]

Options:
  --model <path>        GGUF model path (required)
  --prompt <text>       Single-turn prompt (if omitted, interactive mode)
  --ctx <n>             Context size (default: 4096)
  --predict <n>         Tokens to predict (default: 128)
  --threads <n>         CPU threads (default: auto)
  --batch <n>           Batch size (default: 512)
  --ubatch <n>          UBatch size (default: 512)
  --ngl <n>             GPU layers (default: 99)
  --cpu                 Force CPU mode (sets --device none -ngl 0)
  --temp <v>            Sampling temperature (default: 0.7)
  --seed <n>            Seed (default: 1)
  --turbo-kv            Enable AdiTurbo KV runtime path
  --qjl                 Enable turbo-kv qjl path
  --proj-dim <n>        turbo-kv projection dim (default: 64)
  --ctk <type>          KV K cache type (default with --turbo-kv: q8_0)
  --ctv <type>          KV V cache type (default with --turbo-kv: f16)
  --                    Pass remaining args directly to llama-cli
  -h, --help            Show help
EOF
}

